# environment — rebuilt by install.sh
.venv/
.browsers/

# browser profile — contains Cloudflare cookies / login session.
# MUST NOT be committed anywhere.
profile/
profile.bak-*/

# session + sync transfer bundles (contain cookies / research data)
mrtool-session-*.tar.gz
mrtool-sync-*.tar.gz
session-*.tar.gz

# cookie exports (contain cf_clearance / session cookies) — never commit
cookies*.json
*.cookies.json
cookies.txt
*cookies*.txt

# store backups made by sync-import
store.db.bak-*

# raw capture evidence — big, re-fetchable, excluded from VCS
data/

# python
__pycache__/
*.pyc
*.pyo

# editor/OS
.DS_Store
*.swp

# NOTE: store.db and athletes.json are intentionally tracked — they are the
# accumulated research memory (small, no secrets) and doubling as backup.
